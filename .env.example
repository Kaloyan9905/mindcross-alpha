# Postgres connection string.
#  - Local dev (docker compose): the value below.
#  - Vercel + Neon: use Neon's POOLED connection string here (it ends in
#    "-pooler...") so serverless functions don't exhaust connections.
DATABASE_URL=postgres://mindcross:mindcross_dev@localhost:5432/mindcross

# Optional: a DIRECT (unpooled) Postgres URL used ONLY for running migrations
# (DDL prefers a direct connection). Neon's Vercel integration sets this
# automatically. Falls back to DATABASE_URL if unset.
# DATABASE_URL_UNPOOLED=

NODE_ENV=development

# Auth.js v5 — secret for signing/encrypting tokens and cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=generate-with-openssl-rand-base64-32

# Auth.js v5 — trust the incoming host header (local dev + Vercel).
AUTH_TRUST_HOST=true

# Auth.js v5 — canonical public URL the app is reached at. Used to build
# sign-in/out redirects and the callback-url cookie.
#  - Local HTTP: http://localhost:3000 (keeps cookies non-Secure so they work).
#  - Vercel (production domain): https://your-app.vercel.app (or your domain).
#    On Vercel, cookies are marked Secure automatically even if this is unset
#    (preview URLs), and AUTH_TRUST_HOST=true lets Auth.js use the request host.
AUTH_URL=http://localhost:3000

# Shared secret guarding cron-triggered job endpoints (e.g. the 24h reminder
# scan at /api/cron/reminders). The scheduler must send it as
# `Authorization: Bearer <CRON_SECRET>`. Optional locally; REQUIRED in
# production. Generate one with the same command as AUTH_SECRET.
CRON_SECRET=generate-with-openssl-rand-base64-32

# ── In-app meeting (video call) ─────────────────────────────────────────────
# The session room is peer-to-peer WebRTC and works with no config — public STUN
# handles most networks. To also connect users behind symmetric NAT / strict
# firewalls (i.e. two people on different home networks), add a TURN relay.
#
# Easiest: Cloudflare TURN (free, no credit card). Create a TURN key at
# dash.cloudflare.com → Realtime → TURN, then set:
# CLOUDFLARE_TURN_KEY_ID=
# CLOUDFLARE_TURN_API_TOKEN=
#
# Or self-host coturn (free, no per-call account):
# MEETING_TURN_URL=turn:your-turn-host:3478
# Preferred — a coturn `use-auth-secret` value (must equal --static-auth-secret):
# MEETING_TURN_SECRET=generate-with-openssl-rand-base64-32
# Or static long-term credentials instead of a secret:
# MEETING_TURN_USERNAME=
# MEETING_TURN_CREDENTIAL=
